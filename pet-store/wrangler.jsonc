{
  "name": "happy-pet-harbor",
  "account_id": "a7a742b6369fd624f011fcf2ca10d134",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/account",
      "/account/*",
      "/cart",
      "/cart/*",
      "/checkout",
      "/checkout/*",
      "/shop/*"
    ]
  },
  "routes": [
    {
      "pattern": "raehouser.com",
      "custom_domain": true
    },
    {
      "pattern": "www.raehouser.com",
      "custom_domain": true
    }
  ],
  "main": "src/worker.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "happy-pet-harbor-shop",
      "database_id": "bc8c813d-1569-472f-9c4c-7ab9d4455050"
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
